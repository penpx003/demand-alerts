{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017"],
    "module": "None",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}

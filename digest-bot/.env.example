# ---- Generation (Groq, free tier) ----
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ---- Supabase (free tier) ----
# Project Settings -> API. Use the SECRET / service-role key: the tables have
# row level security enabled, so the publishable key cannot write to them.
#
# Point this at a DIFFERENT Supabase project (or at least accept that the tables
# are separate) from the RAG bot. Nothing is shared between the two services.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key

# ---- Endpoint auth ----
# Shared token the Power Automate flow must send as the X-Digest-Token header.
# The endpoint is publicly reachable, so SET THIS in any deployed environment.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank to disable the check for local testing only.
DEMAND_DIGEST_TOKEN=

# ---- Digest tuning ----
# How many past weeks count towards "this combination is recurring".
DEMAND_TREND_WEEKS=8
# Product-level alert rows are always snapshotted; this caps the Product-Customer
# long tail stored per alert per week, to bound growth on a free Supabase project.
DEMAND_SNAPSHOT_PC_LIMIT=500
# How many top items per alert and level go into the brief the LLM narrates.
DEMAND_TOP_N=8
